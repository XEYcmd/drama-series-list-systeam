@echo off
setlocal
cd /d "%~dp0"

rem ===========================================================================
rem  Worklib launcher - double click to start, close the window to stop.
rem  Same, plus it starts a cpolar http tunnel (fast inside China).
rem  This file is intentionally ASCII-only and CRLF-terminated: cmd.exe parses
rem  batch files in the active code page, so non-ASCII text here can turn into
rem  garbage and even break Chinese paths. All Chinese output comes from
rem  tools\launcher.py (UTF-8 source, Unicode console output).
rem
rem  Generated by the launcher generator script in tools/ - edit that, not this.
rem ===========================================================================

set "PYEXE="
where python >nul 2>nul && set "PYEXE=python"
if not defined PYEXE (
  where py >nul 2>nul && set "PYEXE=py"
)

if not defined PYEXE (
  echo.
  echo   [ERROR] Python not found on this PC.
  echo           Install Python 3.9+ from https://www.python.org/downloads/
  echo           and tick "Add python.exe to PATH", then run this file again.
  echo.
  pause
  exit /b 1
)

if not exist "tools\launcher.py" (
  echo.
  echo   [ERROR] tools\launcher.py not found.
  echo           Keep this file together with the tools and server folders.
  echo.
  pause
  exit /b 1
)

"%PYEXE%" "tools\launcher.py" --with-cpolar %*
set "RC=%ERRORLEVEL%"

echo.
if not "%RC%"=="0" echo   [launcher exit code: %RC%]
if not "%RC%"=="0" echo   If it failed to bind a port (WinError 10013), read the Chinese lines above:
if not "%RC%"=="0" echo     usually that port is reserved by Windows (Hyper-V/WSL/Docker) or taken.
if not "%RC%"=="0" echo     Just run this file again - the launcher will pick a free port itself.
echo   Done. You can close this window.
pause
